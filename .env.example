# Supabase - lidhja me projektin tend
# Merr keto vlera nga: Supabase Dashboard -> Project Settings -> API
# Per frontend perdor vetem anon/public key ose publishable key.
# MOS perdor kurre secret key (`sb_secret_...`) ne kete file.
#
# Render (Static Site): perdor te njejtat celesa VITE_* si Environment Variables;
# NUK perdoren NEXT_PUBLIC_* (projekti eshte Vite, jo Next.js).

VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=anon_jwt_ose_sb_publishable_key_ketu

# ============ AI INTEGRATIONS ============
# Mos vendos OPENAI_API_KEY ose Google secrets ne frontend .env.
# Keto ruhen ne Supabase Edge Function secrets:
#
# supabase secrets set OPENAI_API_KEY=sk-your-openai-key
# supabase secrets set OPENAI_MODEL=gpt-3.5-turbo
#
# Frontend-i therret Supabase Function `openai-chat` me anon key.
